{
  "expo": {
    "name": "Orivo",
    "slug": "orivo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "orivo",
    "newArchEnabled": false,
    "ios": { "supportsTablet": true, "bundleIdentifier": "app.orivo.mobile" },
    "android": { "package": "app.orivo.mobile" },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": false }
  }
}
